#!/usr/bin/env bash
# Run the suite under a lock, so a second run cannot start while one is going.
#
# Two suites at once do not just take twice as long: they oversubscribe the BLAS pools and each other,
# which silently corrupts any timing taken while they overlap (a file measured at 219 s during one
# collision really takes 24 s) and can leave the machine at load 10.  A killed *waiter* is not a killed
# job, so "my wait timed out" is not evidence that the suite stopped -- this lock is, and it says who
# holds it.
#
#   ./run-tests                      the fast suite
#   ./run-tests -m slow              the gated ones
#   NOISESTATE_SLOW=1 ./run-tests    everything
#   ./run-tests tests/test_api.py -k numerics
#
# --wait queues behind a running suite instead of refusing.  The BLAS caps match tests/conftest.py, so a
# run started through this script is capped even if a plugin ever imports numpy before that conftest.
set -euo pipefail
cd "$(dirname "$0")"

LOCK=".run-tests.lock"
WAIT=0
if [ "${1:-}" = "--wait" ]; then WAIT=1; shift; fi

exec 9>"$LOCK"
if [ "$WAIT" = 0 ] && ! flock -n 9; then
    holder=$(cat "$LOCK" 2>/dev/null || true)
    echo "a suite is already running here${holder:+ ($holder)}" >&2
    pgrep -af '[.]venv/bin/python -m pytest' | cut -c1-100 | sed 's/^/  running: /' >&2
    echo "wait for it, run './run-tests --wait ...' to queue, or kill it first." >&2
    echo "do NOT start a second one: concurrent runs corrupt every timing they overlap." >&2
    exit 2
fi
[ "$WAIT" = 1 ] && flock 9
echo "pid $$ started $(date -Is) by ${USER}" >&9

export OMP_NUM_THREADS="${OMP_NUM_THREADS:-4}" OPENBLAS_NUM_THREADS="${OPENBLAS_NUM_THREADS:-4}" \
       MKL_NUM_THREADS="${MKL_NUM_THREADS:-4}" NUMEXPR_NUM_THREADS="${NUMEXPR_NUM_THREADS:-4}" \
       VECLIB_MAXIMUM_THREADS="${VECLIB_MAXIMUM_THREADS:-4}"

start=$(date +%s)
set +e
.venv/bin/python -m pytest -q -p no:cacheprovider "$@"
rc=$?
set -e
echo "run-tests: exit $rc in $(( $(date +%s) - start ))s"
exit $rc
